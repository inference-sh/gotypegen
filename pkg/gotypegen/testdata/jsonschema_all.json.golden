{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "APIResponse": {
      "type": "object",
      "description": "APIResponse is a generic API response wrapper.",
      "properties": {
        "data": {
          "$ref": "#/$defs/T"
        },
        "error": {
          "type": "string"
        },
        "success": {
          "type": "boolean"
        }
      },
      "required": [
        "success"
      ]
    },
    "App": {
      "type": "object",
      "description": "App represents an application.",
      "properties": {
        "category": {
          "$ref": "#/$defs/AppCategory"
        },
        "created_at": {
          "type": "string"
        },
        "deleted_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {}
        },
        "name": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "updated_at": {
          "type": "string"
        },
        "version": {
          "$ref": "#/$defs/AppVersion"
        }
      },
      "required": [
        "id",
        "created_at",
        "updated_at",
        "name",
        "category"
      ]
    },
    "AppCategory": {
      "type": "string",
      "description": "AppCategory represents the category of an app."
    },
    "AppVersion": {
      "type": "object",
      "description": "AppVersion represents a version of an app.",
      "properties": {
        "description": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        }
      },
      "required": [
        "tag"
      ]
    },
    "Application": {
      "description": "Application is a type alias for App.",
      "$ref": "#/$defs/App"
    },
    "Base": {
      "type": "object",
      "description": "Base holds common fields for all models.",
      "properties": {
        "created_at": {
          "type": "string"
        },
        "deleted_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "created_at",
        "updated_at"
      ]
    },
    "CallInput": {
      "type": "object",
      "description": "CallInput embeds GenerationSettings inline (flat JSON) and Base as a\nnamed field (nested JSON).",
      "properties": {
        "base": {
          "$ref": "#/$defs/Base"
        },
        "max_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "prompt": {
          "type": "string"
        },
        "temperature": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "base",
        "prompt"
      ]
    },
    "Document": {
      "type": "object",
      "description": "Document uses types from the shared package.",
      "properties": {
        "cover": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": "string"
        },
        "deleted_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "visibility": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "created_at",
        "updated_at",
        "title",
        "visibility",
        "status"
      ]
    },
    "ExtendedCall": {
      "type": "object",
      "description": "ExtendedCall inherits GenerationSettings (tstype extends): TS/pydantic get\na parent type, JSON Schema gets the parent's properties inlined.",
      "properties": {
        "max_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "prompt": {
          "type": "string"
        },
        "temperature": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "prompt"
      ]
    },
    "GenerationSettings": {
      "type": "object",
      "description": "GenerationSettings is shared by embedding; encoding/json promotes its\nfields onto the embedding struct.",
      "properties": {
        "max_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "temperature": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "LLMDelta": {
      "type": "object",
      "description": "LLMDelta is a streaming delta with field-level merge strategies.",
      "properties": {
        "reasoning": {
          "type": [
            "string",
            "null"
          ]
        },
        "response": {
          "type": "string"
        },
        "tool_calls": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Base"
          }
        },
        "usage": {
          "$ref": "#/$defs/Base"
        }
      },
      "required": [
        "response"
      ]
    },
    "Local": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "MergeStrategy": {
      "type": "string",
      "description": "MergeStrategy defines how a delta field should be merged."
    },
    "ProtocolMeta": {
      "type": "object",
      "description": "ProtocolMeta has JSON tags with dots and slashes that are not valid\nidentifiers in Python or JavaScript — the generators must handle them.",
      "properties": {
        "io.modelcontextprotocol/serverInfo": {
          "$ref": "#/$defs/AppVersion"
        },
        "ttlMs": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "SDKTypes": {
      "type": "object",
      "description": "SDKTypes is a phantom type that pulls types into the trace."
    },
    "StreamDelta": {
      "type": "object",
      "description": "StreamDelta is a marker base for streaming delta types."
    },
    "TaskStatus": {
      "type": "integer",
      "description": "TaskStatus represents the status of a task."
    },
    "Unreferenced": {
      "type": "object",
      "description": "Unreferenced is not referenced by any entry type.",
      "properties": {
        "data": {
          "type": "string"
        }
      },
      "required": [
        "data"
      ]
    }
  }
}